rules_version = '2';

// Parlei database rules.
// Before publishing, replace replace_with_your_email (lower case) with the owner's email,
// the same one as ownerEmail in public/config.js.
//
// Who can see what:
// - The owner (the email below) is the administrator and can see everything.
// - Instructors must be approved by the owner (teachers/{uid}).
// - Each class has one owning instructor (classes/{cid}.teacherId) and optional co-teachers
//   (classes/{cid}.coTeachers), which only the server adds or removes.
// - A student's records are readable only by the student, the owner, and the teachers of the
//   student's classes. That list (members/{uid}.teacherIds) is kept up to date by the server.
// - A class and its content are visible only to its students and teachers. Public lessons, decks
//   and recordings (for Self-study) are visible to everyone signed in.
// - Messages are visible only to the people listed in each conversation.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function isOwner() {
      return signedIn() && request.auth.token.email != null
        && request.auth.token.email.lower() == 'replace_with_your_email'
        && request.auth.token.email_verified == true;
    }
    function isTeacher() {
      return isOwner() || (signedIn() && exists(/databases/$(database)/documents/teachers/$(me())));
    }
    function isSelf(uid) { return signedIn() && me() == uid; }

    // Does the signed-in instructor own or co-teach this class?
    function teachesClass(cid) {
      return isOwner() || (isTeacher()
        && exists(/databases/$(database)/documents/classes/$(cid))
        && (get(/databases/$(database)/documents/classes/$(cid)).data.teacherId == me()
          || get(/databases/$(database)/documents/classes/$(cid)).data.get('coTeachers', {}).keys().hasAny([me()])));
    }
    // Is the signed-in instructor one of this student's teachers?
    function teachesStudent(uid) {
      return isOwner() || (signedIn()
        && exists(/databases/$(database)/documents/members/$(uid))
        && get(/databases/$(database)/documents/members/$(uid)).data.get('teacherIds', []).hasAny([me()]));
    }

    // Is the signed-in user a current student of this class? (members/{uid}.classIds[cid] is the
    // time they joined; false once they leave.) Only the server changes classIds.
    function studentOf(cid) {
      return signedIn()
        && exists(/databases/$(database)/documents/members/$(me()))
        && get(/databases/$(database)/documents/members/$(me())).data.get('classIds', {}).get(cid, false) is number
        && get(/databases/$(database)/documents/members/$(me())).data.get('classIds', {}).get(cid, false) > 0;
    }
    function canSeeClass(cid) { return isOwner() || teachesClass(cid) || studentOf(cid); }

    // Classes, and everything inside them, are visible only to the class's students and teachers
    // (and the owner). Nobody can list other people's classes, so join codes stay private:
    // students join through the server, which checks the code.
    match /classes/{cid} {
      allow get: if canSeeClass(cid);
      allow list: if isOwner() || (signedIn() && resource.data.teacherId == me());
      allow create: if isTeacher() && request.resource.data.teacherId == me()
        && !('coTeachers' in request.resource.data);
      allow update: if (isOwner() || resource.data.teacherId == me())
        && request.resource.data.teacherId == resource.data.teacherId
        && request.resource.data.get('coTeachers', {}) == resource.data.get('coTeachers', {});
      allow delete: if false;

      // Class content: lessons, assignments, decks, events, announcements, audio, recs.
      // Read by the class; written only by its teachers, and an item can't claim another class.
      match /{kind}/{id} {
        allow read: if canSeeClass(cid);
        allow create, update: if kind in ['lessons', 'assignments', 'decks', 'events', 'announcements', 'audio', 'recs']
          && teachesClass(cid) && request.resource.data.classId == cid;
        allow delete: if teachesClass(cid);
      }
    }

    // Self-study: lessons, flashcard decks and recordings a teacher marked public can be read by
    // anyone signed in. The app lists them with where('public', '==', true).
    match /{path=**}/lessons/{id} { allow read: if signedIn() && resource.data.public == true; }
    match /{path=**}/decks/{id}   { allow read: if signedIn() && resource.data.public == true; }
    match /{path=**}/audio/{id}   { allow read: if signedIn() && resource.data.public == true; }

    // Approved instructors. Only the owner approves (or removes) them.
    match /teachers/{uid} { allow read: if isSelf(uid) || isOwner(); allow write: if isOwner(); }

    // Instructor sign-ups: the applicant creates a pending request; only the owner decides.
    match /instructorRequests/{uid} {
      allow read: if isSelf(uid) || isOwner();
      allow create: if isSelf(uid) && request.resource.data.status == 'pending';
      allow update, delete: if isOwner();
    }

    // Class membership. Only the server changes classIds (joining checks the code) and teacherIds.
    // Teachers list their students with: where('teacherIds', 'array-contains', <their uid>).
    match /members/{uid} {
      allow read: if isSelf(uid) || isOwner() || (signedIn() && me() in resource.data.get('teacherIds', []));
      allow create: if isSelf(uid) && !('teacherIds' in request.resource.data) && !('classIds' in request.resource.data);
      allow update: if isSelf(uid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['teacherIds', 'classIds']);
      allow delete: if isOwner();
    }

    // A student's profile: readable by the student and any of their teachers; written by the student.
    match /profiles/{uid} { allow read: if isSelf(uid) || teachesStudent(uid); allow write: if isSelf(uid); }

    // Messages: each conversation is visible only to the people listed in it (participants),
    // the owner included. Everyone listed must be the student or one of the student's teachers,
    // and the list can't change after the conversation starts.
    function allowedIn(student) {
      return get(/databases/$(database)/documents/members/$(student)).data.get('teacherIds', []).concat([student]);
    }
    match /convos/{id} {
      allow read: if signedIn() && me() in resource.data.participants;
      allow create: if signedIn()
        && request.resource.data.student is string
        && me() in request.resource.data.participants
        && request.resource.data.student in request.resource.data.participants
        && request.resource.data.participants.size() >= 2
        && request.resource.data.participants.size() <= 12
        && exists(/databases/$(database)/documents/members/$(request.resource.data.student))
        && (request.resource.data.participants.hasOnly(allowedIn(request.resource.data.student))
          || (isOwner() && request.resource.data.participants.hasOnly(allowedIn(request.resource.data.student).concat([me()]))));
      allow update: if signedIn() && me() in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.student == resource.data.student;
      allow delete: if false;
    }

    // Submissions, grades and flashcard progress are stored per student per class, with the id
    // {studentUid}__{classId}. Only the student and the teachers of THAT class can read them, so a
    // teacher never sees a shared student's work from another teacher's class.
    function recStudent(key) { return key.split('__')[0]; }
    function recClass(key) { return key.split('__')[1]; }
    match /subs/{key}   { allow read: if isSelf(recStudent(key)) || teachesClass(recClass(key)); allow write: if isSelf(recStudent(key)); }
    match /prog/{key}   { allow read: if isSelf(recStudent(key)) || teachesClass(recClass(key)); allow write: if isSelf(recStudent(key)); }
    match /grades/{key} { allow read: if isSelf(recStudent(key)) || teachesClass(recClass(key)); allow write: if teachesClass(recClass(key)); }

    // Personal word bank and media repertoire: private to the student (and the owner).
    match /vocab/{uid}    { allow read: if isSelf(uid) || isOwner(); allow write: if isSelf(uid); }
    match /media/{uid}    { allow read: if isSelf(uid) || isOwner(); allow write: if isSelf(uid); }

    // Office-hour bookings: everyone sees which slots are taken; each person books for themselves.
    match /bookings/{uid} { allow read: if signedIn(); allow write: if isSelf(uid) || isOwner(); }

    // Devices that receive push notifications.
    match /pushTokens/{uid} { allow read, write: if isSelf(uid); }

    // Server-only records (notification log, look-up counts).
    match /notifLog/{id} { allow read, write: if false; }
    match /usage/{id}    { allow read, write: if false; }
  
    // Notebook: private to the writer. Not even teachers or the owner can read it.
    match /notes/{uid}/items/{id} {
      allow read, write: if isSelf(uid);
    }
}
}
