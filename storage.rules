rules_version = '2';

// Parlei file storage rules (class audio recordings).
// Replace replace_with_your_email (lower case) with the teacher's email, as in firestore.rules.
service firebase.storage {
  match /b/{bucket}/o {
    match /audio/{classId}/{file} {
      allow read: if request.auth != null;
      allow delete: if isTeacher();
      allow create, update: if isTeacher()
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*|video/mp4|video/webm|application/octet-stream');
    }

    function isTeacher() {
      return request.auth != null && (
        (request.auth.token.email != null
          && request.auth.token.email.lower() == 'replace_with_your_email'
          && request.auth.token.email_verified == true)
        || firestore.exists(/databases/(default)/documents/teachers/$(request.auth.uid)));
    }
  }
}
